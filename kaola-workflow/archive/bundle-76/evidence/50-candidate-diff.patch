+def test_droid_worker_wake_is_metadata_only_and_idempotent() -> None:
+    """A bound non-ZCode ACP worker (the droid shape): same wake, no leak, one
+    event per NEW pending request even when the agent re-sends the same id."""
+    sandbox = Sandbox("droid")
+    try:
+        fake = sandbox.dir / "fake-permission-agent.py"
+        fake.write_text(PERMISSION_ACP_AGENT, encoding="utf-8")
+        fake.chmod(fake.stat().st_mode | 0o755)
+        host = sandbox.session()
+        worker = f"droid-pw-{uuid.uuid4().hex[:8]}"
+        sandbox.start(host, "basic")
+        sandbox.write_prompt_file("HEARTBEAT DROID: metadata-only wake body.")
+
+        worker_start = sandbox.cli(
+            "start", "--command", f"{PYTHON} {fake}", session=worker,
+            platform="droid",
+            **{HEARTBEAT_HOST_ENV: json.dumps(
+                {"platform": "zcode", "session": host, "repo": str(sandbox.repo)}),
+               "PERMISSION_FAKE_RETRANSMIT": "1"})
+        check(worker_start.get("error") is None and worker_start.get("state") == "ready",
+              f"droid worker starts ({worker_start.get('error')})")
+        # First the actual delegation receipt, before any pending exists:
+        # auto-high is what start really applied — a fact, not a promise that
+        # the native side can never ask.
+        application = worker_start.get("config_application") or {}
+        mode = application.get("mode") or {}
+        check(mode.get("applied") is True and mode.get("value") == "auto-high",
+              f"start applied the real delegation ({application.get('mode')})")
+        fact = worker_start.get("heartbeat_host") or {}
+        check(fact.get("session") == host, f"armed start carries the host fact ({fact})")
+
+        send = sandbox.cli("send", "--no-wait", "--text", "do work", session=worker,
+                           platform="droid")
+        check(send.get("outcome") == "in_progress", "droid worker prompt admitted")
+        wait_until(lambda: (sandbox.cli("status", session=worker, platform="droid")
+                            .get("pending_permissions") or []),
+                   15, "droid worker waits on its permission")
+        status = sandbox.cli("status", session=worker, platform="droid")
+        check(status.get("turn_active") is True and status.get("activity_hint") == "waiting",
+              "the droid worker turn is active and waiting")
+        pending = status.get("pending_permissions") or []
+        check(pending[0].get("title") == MARKER_TITLE,
+              "the worker's own bounded receipt keeps the request detail")
+
+        worker_dir = sandbox.record_dir(worker, platform="droid")
+        requests = [entry for entry in read_events(worker_dir)
+                    if entry.get("kind") == "request_permission"]
+        check(len(requests) == 2, "the agent's re-sent request is on record")
+        carrier = carrier_entries(worker_dir, "permission_required")
+        check(len(carrier) == 1,
+              f"a re-sent request id stays ONE permission wake ({len(carrier)})")
+        check(len(sandbox.cli("status", session=worker, platform="droid")
+                  .get("pending_permissions") or []) == 1,
+              "the pending list holds the single request")
+
+        host_dir = sandbox.record_dir(host)
+        wait_until(lambda: events_of_kind(host_dir, "worker_event_delivered"), 15,
+                   "the droid wake reaches the idle host and delivers")
+        staged = worker_event_entries(host_dir)
+        check(len(staged) == 1 and staged[0]["kind"] == "permission_required"
+              and staged[0]["platform"] == "droid" and staged[0]["session"] == worker,
+              f"the staged event is the droid permission wake ({staged})")
+        event = staged[0]
+        check(str(event.get("request_id")) == str(PERMISSION_REQUEST_ID),
+              "the event carries the request locator")
+        check(set(event) <= ALLOWED_EVENT_KEYS,
+              f"the event is metadata only ({sorted(event)})")
+        event_blob = json.dumps(event, sort_keys=True)
+        check(MARKER_TITLE not in event_blob and MARKER_OPTION not in event_blob,
+              "no title or option text travels in the staged event")
+        sends = rpc_sends(sandbox.rpcs[host])
+        check(len(sends) == 1 and MARKER_TITLE not in sends[0]
+              and MARKER_OPTION not in sends[0],
+              "the delivered prompt carries no request detail, only the locator")
+        check(str(PERMISSION_REQUEST_ID) in sends[0],
+              "the delivered prompt does carry the request_id")
+        check(FIXTURE_SECRET not in sends[0], "no credential reaches the prompt")
+
+        # permit settles it; a repeated permit is an honest no-op error, and
+        # the ordinary turn-end idle still arrives afterwards.
+        permit = sandbox.cli("permit", "--request-id", str(PERMISSION_REQUEST_ID),
+                             "--option", "allow", session=worker, platform="droid")
+        check(permit.get("permitted") is not None,
+              f"permit settles the request ({permit.get('error')})")
+        again = sandbox.invoke("permit", "--request-id", str(PERMISSION_REQUEST_ID),
+                               "--option", "allow", session=worker, platform="droid")[1] or {}
+        check((again.get("error") or {}).get("code") == "no-pending-permission",
+              f"an already-settled request is an idempotent error ({again.get('error')})")
+        wait_until(lambda: len(worker_event_entries(host_dir)) == 2, 15,
+                   "the ordinary idle still arrives after the wake")
+        check(worker_event_entries(host_dir)[1]["kind"] == "idle",
+              "the second event is the real turn-end idle")
+
+        for platform, session in (("droid", worker), ("zcode", host)):
+            stop = sandbox.cli("stop", "--force", session=session, platform=platform)
+            check(stop.get("residual_pids") == [], f"{session} stop leaves no residue")
+    finally:
+        sandbox.cleanup()
+
