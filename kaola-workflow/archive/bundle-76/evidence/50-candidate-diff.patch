+def test_unbound_worker_permission_is_unchanged() -> None:
+    sandbox = Sandbox("unbound")
+    try:
+        worker = sandbox.session()
+        sandbox.start(worker, "permission")
+        send = sandbox.cli("send", "--no-wait", "--text", "do work", session=worker)
+        check(send.get("outcome") == "in_progress", "unbound worker prompt admitted")
+        wait_until(lambda: (sandbox.cli("status", session=worker).get("pending_permissions")
+                            or []), 15, "unbound worker waits on its permission")
+        status = sandbox.cli("status", session=worker)
+        check(status.get("turn_active") is True and status.get("activity_hint") == "waiting",
+              "the unbound worker reports the same pending shape")
+        check(not carrier_entries(sandbox.record_dir(worker)),
+              "an unbound worker sends nothing anywhere")
+        permit = sandbox.cli("permit", "--option", "allow", session=worker)
+        check(permit.get("permitted") is not None, "the unbound permit still works")
+        check(not carrier_entries(sandbox.record_dir(worker)),
+              "settling changed no carrier behavior")
+        stop = sandbox.cli("stop", "--force", session=worker)
+        check(stop.get("residual_pids") == [], "unbound worker stop leaves no residue")
+    finally:
+        sandbox.cleanup()
+
