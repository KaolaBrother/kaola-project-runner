+def test_worker_event_validation_accepts_permission_required() -> None:
+    sandbox = Sandbox("validate")
+    try:
+        host = sandbox.session()
+        sandbox.start(host, "basic")
+        host_dir = sandbox.record_dir(host)
+        sock = holder_socket(host_dir)
+
+        base = {"schema": "kaola-worker-event/1", "kind": "permission_required",
+                "platform": "droid", "session": "droid-pw-x",
+                "repo": os.path.realpath(str(sandbox.repo)),
+                "reason": "session/request_permission pending", "event_cursor": 11}
+        receipt = holder_op(sock, "worker_event", {**base, "request_id": "7"})
+        check(receipt.get("staged") is True and receipt.get("error") is None,
+              f"the new kind stages with a string request_id ({receipt})")
+        receipt = holder_op(sock, "worker_event", {**base, "event_cursor": 12,
+                                                   "request_id": 7})
+        check(receipt.get("staged") is True,
+              f"the new kind stages with an integer request_id ({receipt})")
+        receipt = holder_op(sock, "worker_event", {**base, "event_cursor": 12,
+                                                   "request_id": 7})
+        check(receipt.get("duplicate") is True,
+              f"an identical event stays a deduped duplicate ({receipt})")
+        for bad in ({"nested": 1}, ["list"], True):
+            receipt = holder_op(sock, "worker_event", {**base, "event_cursor": 13,
+                                                       "request_id": bad})
+            check((receipt.get("error") or {}).get("code") == "worker-event-invalid",
+                  f"a malformed request_id is rejected ({receipt})")
+        receipt = holder_op(sock, "worker_event", {**base, "kind": "bogus",
+                                                   "event_cursor": 14})
+        check((receipt.get("error") or {}).get("code") == "worker-event-invalid",
+              f"an unknown kind is still rejected ({receipt})")
+
+        # The host is idle: each staged event delivers its own prompt at once.
+        wait_until(lambda: len(events_of_kind(host_dir, "worker_event_delivered")) == 2
+                   and len(rpc_sends(sandbox.rpcs[host])) == 2, 15,
+                   "each staged permission event delivers on the idle host")
+        sends = rpc_sends(sandbox.rpcs[host])
+        check("permission_required" in sends[0] and '"request_id": "7"' in sends[0],
+              "the first delivered line carries the string request_id")
+        check("permission_required" in sends[1] and '"request_id": 7' in sends[1],
+              "the second delivered line carries the integer request_id")
+
+        host_stop = sandbox.cli("stop", "--force", session=host)
+        check(host_stop.get("residual_pids") == [], "host stop leaves no residue")
+    finally:
+        sandbox.cleanup()
+
+
+TESTS = (
+    test_permission_required_wakes_idle_host_while_turn_active,
+    test_permission_event_stages_on_busy_host_then_flushes,
+    test_droid_worker_wake_is_metadata_only_and_idempotent,
+    test_unbound_worker_permission_is_unchanged,
+    test_worker_event_validation_accepts_permission_required,
+)
+
+
+def main() -> int:
+    for test in TESTS:
+        CHECKS.clear()
+        test()
+        print(f"PASS {test.__name__} ({len(CHECKS)} checks)")
+    print(f"PASS: issue-76 permission wake contract ({len(TESTS)} tests)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
