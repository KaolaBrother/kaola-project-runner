+               "failures": failures, "evidence": EVIDENCE, "root": str(ROOT)}
+    if args.evidence_out:
+        Path(args.evidence_out).write_text(json.dumps(payload, indent=2, sort_keys=True))
+    print(json.dumps(payload, indent=2, sort_keys=True))
