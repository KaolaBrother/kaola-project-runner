-    state.outer_pending.clear()
-    while True:
-        ready, _, _ = select.select([sys.stdin.fileno()], [], [], 0)
-        if not ready:
-            return
-        try:
-            block = os.read(sys.stdin.fileno(), 65536)
-        except BlockingIOError:
-            return
-        if not block:
-            return
