-            bool(group_states)
-            and all(value.startswith("T") for value in group_states)
-            and all(value.startswith("T") for value in current.values())
-        )
-        current_ids = set(current)
-        if stopped and current_ids == previous:
-            stable += 1
-            if stable >= 2:
