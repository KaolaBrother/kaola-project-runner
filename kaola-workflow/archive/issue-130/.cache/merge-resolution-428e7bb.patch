-def _signal_tracked(state: RelayState, signum: int) -> None:
-    for pid, fingerprint in list(state.tracked_descendants.items()):
-        if process_fingerprint(pid) != fingerprint:
-            state.tracked_descendants.pop(pid, None)
-            continue
-        try:
