-    if not group_states or any(value.startswith("T") for value in group_states):
-        return False
-    rows = _process_rows()
-    for pid, fingerprint in list(state.tracked_descendants.items()):
-        if process_fingerprint(pid) != fingerprint:
-            continue
-        process_state = rows.get(pid, (0, ""))[1]
