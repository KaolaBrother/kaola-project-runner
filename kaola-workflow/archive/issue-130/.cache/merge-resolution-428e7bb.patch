-def _write_child(state: RelayState, data: bytes) -> None:
-    view = memoryview(data)
-    while view:
-        try:
-            count = os.write(state.child_master, view)
-            view = view[count:]
-        except BlockingIOError:
-            select.select([], [state.child_master], [], 0.1)
-    state.input_offset += len(data)
