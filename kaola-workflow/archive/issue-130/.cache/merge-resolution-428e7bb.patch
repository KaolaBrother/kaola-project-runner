-        return _reply(
-            state,
-            request,
-            "resumed",
-            relay=state.facts(),
-            restoration_evidence={
-                "child_resumed": True,
-                "pane_input_restored": True,
-                "relay_responsive": True,
-                "process_group_running": True,
-                "lease_released": True,
-            },
-        )
