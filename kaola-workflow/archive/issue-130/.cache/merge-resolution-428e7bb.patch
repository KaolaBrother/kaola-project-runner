-    if not ready:
-        return
-    try:
-        block = os.read(sys.stdin.fileno(), 65536)
-    except BlockingIOError:
-        return
-    state.outer_pending.clear()
-    if not block:
-        raise RuntimeError("outer PTY closed before submit")
-    raise RuntimeError("unexpected outer input before submit")
