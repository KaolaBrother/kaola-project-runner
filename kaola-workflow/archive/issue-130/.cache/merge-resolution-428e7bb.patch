-        return
-    state.shutdown_started = True
-    if state.child_pgid > 0:
-        _signal_tracked(state, signal.SIGTERM)
-        try:
-            os.killpg(state.child_pgid, signal.SIGTERM)
-        except ProcessLookupError:
