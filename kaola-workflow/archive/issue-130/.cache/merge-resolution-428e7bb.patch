-        deadline = time.monotonic() + 0.5
-        while time.monotonic() < deadline:
-            tracked_alive = any(
-                process_fingerprint(pid) == fingerprint
-                for pid, fingerprint in state.tracked_descendants.items()
-            )
-            try:
-                os.killpg(state.child_pgid, 0)
