-def process_command(pid: int) -> str:
-    if pid <= 0:
-        return ""
-    result = subprocess.run(["ps", "-ww", "-p", str(pid), "-o", "command="], capture_output=True, text=True)
-    return result.stdout.strip() if result.returncode == 0 else ""
