-
-def recv_exact(sock, count: int) -> bytes:
-    blocks = bytearray()
-    while len(blocks) < count:
-        block = sock.recv(count - len(blocks))
-        if not block:
-            raise EOFError("relay connection closed")
-        blocks.extend(block)
-    return bytes(blocks)
-
-
-def send_frame(sock, header: dict[str, Any], payload: bytes = b"") -> None:
