-        pid, ppid = int(match.group(1)), int(match.group(2))
-        if pid <= 0 or ppid < 0 or pid in seen:
-            raise ValueError(f"invalid or duplicate process pid at row {number}")
-        seen.add(pid)
-        command = os.path.basename(match.group(4).rstrip("/"))
