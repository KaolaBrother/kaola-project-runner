-def _tail_lines(data: bytes, keep: int) -> bytes:
-    tail = data[-keep:] if keep > 0 else b""
-    newline = tail.find(b"\n")
-    if 0 <= newline < len(tail) - 1:
-        tail = tail[newline + 1:]
-    return tail
