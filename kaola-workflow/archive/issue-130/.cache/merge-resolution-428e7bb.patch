-                "receipt_id": request["receipt_id"],
-                "prepared_pane_revision": request["prepared_pane_revision"],
-                "prepared_frame_revision": request["prepared_frame_revision"],
-                "submitted_output_offset": state.output_offset,
-                "state": "pending",
